std::map<uint64_t,uint32_t> currentSummonKinds;
std::vector<editor_summon_material_info> currentSummonMaterials;
std::vector<editor_command> summonHistoryDraft,summonHistoryOriginal;
bool summonHistoryReady=false;uint32_t loadedSummonKind=0;uint64_t summonExisting=0;
irr::gui::IGUICheckBox* correspondingSummon{};irr::gui::IGUIButton* summonHistoryOpen{};irr::gui::IGUIWindow* summonHistoryWindow{};
irr::gui::IGUIComboBox *summonPickMode{},*summonMaterialOwner{},*summonSourcePlayer{},*summonDestinationPlayer{},*materialSourceZone{},*materialDestinationZone{},*materialSourcePosition{},*materialDestinationPosition{};
irr::gui::IGUIEditBox *summonMaterialSearch{},*materialSourceSlot{},*materialDestinationSlot{};
irr::gui::IGUIListBox *summonMaterialResults{},*summonMaterialRows{};irr::gui::IGUIStaticText* summonMaterialStatus{};
std::vector<std::pair<uint32_t,uint64_t>> summonMaterialMatches;
uint32_t SummonKindChoice(){uint32_t type=EffectiveType();if(location->getItemData(location->getSelected())!=LOCATION_MZONE||!specialOrigin->isChecked())return 0;if(type&TYPE_RITUAL)return 5;if(summonSource->getItemData(summonSource->getSelected())!=LOCATION_EXTRA)return 0;return type&TYPE_FUSION?1:type&TYPE_SYNCHRO?2:type&TYPE_XYZ?3:type&TYPE_LINK?4:0;}
const wchar_t* SummonKindName(uint32_t kind){const wchar_t* names[]={L"特殊",L"融合",L"同调",L"超量",L"连接",L"仪式"};return names[kind<=5?kind:0];}
std::wstring SummonRegion(uint32_t z){return z==LOCATION_DECK?L"卡组":z==LOCATION_HAND?L"手牌":z==LOCATION_MZONE?L"怪兽区":z==LOCATION_SZONE?L"魔法陷阱区":z==LOCATION_GRAVE?L"墓地":z==LOCATION_REMOVED?L"除外区":z==LOCATION_EXTRA?L"额外卡组":L"超量素材";}
void UpdateSummonHistoryUI(){if(!correspondingSummon)return;uint32_t kind=SummonKindChoice();correspondingSummon->setVisible(kind!=0);std::wstring text=L"作为"+std::wstring(SummonKindName(kind))+L"召唤";correspondingSummon->setText(text.c_str());summonHistoryOpen->setVisible(kind&&correspondingSummon->isChecked());}
void ResetSummonHistory(const editor_card_info* card){summonHistoryDraft.clear();loadedSummonKind=card?currentSummonKinds[card->id]:0;summonHistoryReady=false;if(correspondingSummon)correspondingSummon->setChecked(loadedSummonKind!=0);if(card)for(const auto& m:currentSummonMaterials)if(m.host_id==card->id){editor_command c{};c.opcode=13;c.code=m.code;c.owner=m.owner;c.player=m.source_player;c.location=m.source_location;c.sequence=m.source_sequence;c.position=m.source_position;c.value=m.destination_location;c.attack=m.destination_player;c.defense=m.destination_sequence;c.level=m.destination_position;c.states=uint32_t(m.card_id);c.restrictions=uint32_t(m.card_id>>32);summonHistoryDraft.push_back(c);}summonHistoryOriginal=summonHistoryDraft;}
bool SummonHistoryNeeded(){bool same=summonHistoryDraft.size()==summonHistoryOriginal.size();for(size_t i=0;same&&i<summonHistoryDraft.size();i++)same=std::memcmp(&summonHistoryDraft[i],&summonHistoryOriginal[i],sizeof(editor_command))==0;if(correspondingSummon&&loadedSummonKind==(correspondingSummon->isChecked()?SummonKindChoice():0)&&same)return false;return correspondingSummon&&((correspondingSummon->isChecked()&&SummonKindChoice())||(loadedSummonKind&&location->getItemData(location->getSelected())==LOCATION_MZONE&&specialOrigin->isChecked()));}
void AppendSummonHistory(std::vector<editor_command>& commands,const editor_command& host){if(!SummonHistoryNeeded())return;editor_command begin{};begin.opcode=12;begin.target_low=host.target_low;begin.target_high=host.target_high;begin.value=correspondingSummon->isChecked()?SummonKindChoice():0;commands.push_back(begin);if(!begin.value)return;for(auto c:summonHistoryDraft){c.target_low=host.target_low;c.target_high=host.target_high;if(begin.value==3)c.value=LOCATION_OVERLAY;commands.push_back(c);}editor_command finish{};finish.opcode=14;finish.target_low=host.target_low;finish.target_high=host.target_high;commands.push_back(finish);}
void SummonMaterialZones(irr::gui::IGUIComboBox* box,uint32_t type,bool destination){uint32_t old=box->getItemData(box->getSelected());box->clear();if(destination&&SummonKindChoice()==3){box->addItem(L"叠放为超量素材",LOCATION_OVERLAY);return;}for(uint32_t z:{LOCATION_DECK,LOCATION_HAND,LOCATION_MZONE,LOCATION_SZONE,LOCATION_GRAVE,LOCATION_REMOVED,LOCATION_EXTRA}){if((z==LOCATION_DECK||z==LOCATION_HAND)&&(type&TYPES_EXTRA_DECK))continue;if(z==LOCATION_EXTRA&&!(type&(TYPES_EXTRA_DECK|TYPE_PENDULUM)))continue;box->addItem(SummonRegion(z).c_str(),z);}ComboValue(box,old);}
void RefreshSummonMaterialRows(){summonMaterialRows->clear();for(const auto& c:summonHistoryDraft){std::wstring text=std::wstring(dataManager.GetName(c.code))+L" · 玩家 "+std::to_wstring(c.player+1)+L" "+SummonRegion(c.location)+((c.location&LOCATION_ONFIELD)?L" "+std::to_wstring(c.sequence+1):L"")+L" → 玩家 "+std::to_wstring(c.attack+1)+L" "+SummonRegion(c.value)+((c.value&LOCATION_ONFIELD)?L" "+std::to_wstring(c.defense+1):L"");summonMaterialRows->addItem(text.c_str());}}
void FilterSummonMaterials(){summonMaterialMatches.clear();summonMaterialResults->clear();std::wstring term=summonMaterialSearch->getText();bool existing=summonPickMode->getSelected()==1;if(existing){for(const auto& c:currentCards)if(c.id!=selectedID&&c.location!=LOCATION_OVERLAY&&(c.effective_type&TYPE_MONSTER)&&(term.empty()||dataManager.CardNameContains(dataManager.GetName(c.code),term.c_str())||std::to_wstring(c.code).find(term)!=std::wstring::npos))summonMaterialMatches.push_back({c.code,c.id});}else if(!term.empty())for(const auto& row:dataManager.GetStringTable()){CardData data{};if(dataManager.GetData(row.first,&data)&&(data.type&TYPE_MONSTER)&&!(data.type&TYPE_TOKEN)&&(dataManager.CardNameContains(row.second.name.c_str(),term.c_str())||std::to_wstring(row.first).find(term)!=std::wstring::npos))summonMaterialMatches.push_back({row.first,0});}if(summonMaterialMatches.size()>200)summonMaterialMatches.resize(200);for(const auto& match:summonMaterialMatches){std::wstring text=std::wstring(dataManager.GetName(match.first))+L" ["+std::to_wstring(match.first)+L"]";if(match.second)for(const auto& c:currentCards)if(c.id==match.second)text+=L" · 玩家 "+std::to_wstring(c.player+1)+L" "+SummonRegion(c.location)+L" "+std::to_wstring(c.sequence+1);summonMaterialResults->addItem(text.c_str());}}
void UpdateSummonMaterialPositionControls(){int index=summonMaterialResults->getSelected();if(index<0||size_t(index)>=summonMaterialMatches.size())return;CardData data{};dataManager.GetData(summonMaterialMatches[index].first,&data);for(int side=0;side<2;side++){auto* zone=side?materialDestinationZone:materialSourceZone;auto* pos=side?materialDestinationPosition:materialSourcePosition;auto* slot=side?materialDestinationSlot:materialSourceSlot;uint32_t loc=zone->getItemData(zone->getSelected()),old=pos->getItemData(pos->getSelected());slot->setVisible(loc==LOCATION_MZONE||loc==LOCATION_SZONE);pos->clear();std::vector<uint32_t> choices;if(loc==LOCATION_HAND||loc==LOCATION_DECK)choices={POS_FACEDOWN_DEFENSE};else if(loc==LOCATION_GRAVE||loc==LOCATION_OVERLAY)choices={POS_FACEUP_ATTACK};else if(loc==LOCATION_EXTRA){if(!(data.type&TYPE_PENDULUM))choices={POS_FACEDOWN_DEFENSE};else if(!(data.type&TYPES_EXTRA_DECK))choices={POS_FACEUP_ATTACK};else choices={POS_FACEUP_ATTACK,POS_FACEDOWN_DEFENSE};}else if(loc==LOCATION_MZONE){if(data.type&TYPE_LINK)choices={POS_FACEUP_ATTACK};else choices={POS_FACEUP_ATTACK,POS_FACEUP_DEFENSE,POS_FACEDOWN_DEFENSE};}else choices={POS_FACEUP_ATTACK,POS_FACEDOWN_DEFENSE};for(uint32_t v:choices)pos->addItem(v==POS_FACEUP_DEFENSE?L"表侧守备":v==POS_FACEDOWN_DEFENSE?L"里侧":L"表侧",v);ComboValue(pos,old);pos->setEnabled(choices.size()>1);}uint32_t dest=materialDestinationZone->getItemData(materialDestinationZone->getSelected());summonDestinationPlayer->setEnabled(dest&LOCATION_ONFIELD);if(!(dest&LOCATION_ONFIELD))summonDestinationPlayer->setSelected(summonMaterialOwner->getSelected());}
void SelectSummonMaterial(){int i=summonMaterialResults->getSelected();if(i<0||size_t(i)>=summonMaterialMatches.size())return;auto match=summonMaterialMatches[i];summonExisting=match.second;CardData data{};dataManager.GetData(match.first,&data);SummonMaterialZones(materialSourceZone,data.type,false);SummonMaterialZones(materialDestinationZone,data.type,true);materialSourceSlot->setText(L"1");materialDestinationSlot->setText(L"1");ComboValue(summonMaterialOwner,player->getSelected());ComboValue(summonSourcePlayer,player->getSelected());ComboValue(summonDestinationPlayer,player->getSelected());ComboValue(materialDestinationZone,SummonKindChoice()==3?LOCATION_OVERLAY:LOCATION_GRAVE);for(const auto& c:currentCards)if(c.id==summonExisting){ComboValue(summonMaterialOwner,c.owner);ComboValue(summonSourcePlayer,c.player);ComboValue(materialSourceZone,c.location);ComboValue(materialSourcePosition,c.position);materialSourceSlot->setText(std::to_wstring(c.sequence+1).c_str());}if(!(data.type&TYPE_PENDULUM)){if(materialSourceZone->getItemData(materialSourceZone->getSelected())==LOCATION_EXTRA)ComboValue(materialSourcePosition,POS_FACEDOWN_DEFENSE);if(materialDestinationZone->getItemData(materialDestinationZone->getSelected())==LOCATION_EXTRA)ComboValue(materialDestinationPosition,POS_FACEDOWN_DEFENSE);}UpdateSummonMaterialPositionControls();mainGame->ShowCardInfo(match.first);}
void OpenSummonHistory(){if(!SummonKindChoice()||!correspondingSummon->isChecked())return;summonHistoryReady=true;std::wstring title=std::wstring(SummonKindName(SummonKindChoice()))+L"召唤素材与移动履历";summonHistoryWindow->setText(title.c_str());FilterSummonMaterials();RefreshSummonMaterialRows();panel->setVisible(false);mainGame->PopupElement(summonHistoryWindow);}
void AddSummonMaterial(){int i=summonMaterialResults->getSelected();if(i<0||size_t(i)>=summonMaterialMatches.size()){summonMaterialStatus->setText(L"请选择素材卡片");return;}if(summonHistoryDraft.size()>=255){summonMaterialStatus->setText(L"最多 255 张素材");return;}for(const auto& c:summonHistoryDraft)if(summonExisting&&((uint64_t(c.restrictions)<<32)|c.states)==summonExisting){summonMaterialStatus->setText(L"该卡片已在列表中");return;}editor_command c{};c.opcode=13;c.code=summonMaterialMatches[i].first;c.owner=summonMaterialOwner->getSelected();c.player=summonSourcePlayer->getSelected();c.location=materialSourceZone->getItemData(materialSourceZone->getSelected());c.position=materialSourcePosition->getItemData(materialSourcePosition->getSelected());c.value=materialDestinationZone->getItemData(materialDestinationZone->getSelected());c.attack=(c.value&LOCATION_ONFIELD)?summonDestinationPlayer->getSelected():c.owner;c.level=materialDestinationPosition->getItemData(materialDestinationPosition->getSelected());uint32_t src=1,dst=1;if((c.location&LOCATION_ONFIELD)&&(!Number(materialSourceSlot,src)||!src||src>(c.location==LOCATION_MZONE?7u:5u))){summonMaterialStatus->setText(L"来源位置无效");return;}if((c.value&LOCATION_ONFIELD)&&(!Number(materialDestinationSlot,dst)||!dst||dst>(c.value==LOCATION_MZONE?7u:5u))){summonMaterialStatus->setText(L"去向位置无效");return;}c.sequence=src-1;if(summonExisting&&!(c.location&LOCATION_ONFIELD))for(const auto& card:currentCards)if(card.id==summonExisting)c.sequence=card.sequence;c.defense=dst-1;c.states=uint32_t(summonExisting);c.restrictions=uint32_t(summonExisting>>32);summonHistoryDraft.push_back(c);RefreshSummonMaterialRows();summonMaterialStatus->setText(L"返回后生成或保存修改时应用");}
void InitializeSummonHistory(){auto* env=mainGame->env;correspondingSummon=env->addCheckBox(false,{225,405,395,427},panel,9901,L"对应召唤");summonHistoryOpen=env->addButton({210,490,305,517},panel,9902,L"召唤素材…");summonHistoryWindow=env->addWindow({200,20,840,625},false,L"召唤素材与移动履历",nullptr,9900);summonHistoryWindow->getCloseButton()->setVisible(false);summonHistoryWindow->setVisible(false);
 summonPickMode=env->addComboBox({15,35,625,63},summonHistoryWindow,9903);summonPickMode->addItem(L"搜索并生成素材",0);summonPickMode->addItem(L"选用局面中已有卡片",1);summonMaterialSearch=env->addEditBox(L"",{15,72,625,100},true,summonHistoryWindow,9904);summonMaterialResults=env->addListBox({15,110,625,220},summonHistoryWindow,9905,true);summonMaterialResults->setItemHeight(25);
 env->addStaticText(L"来源",{15,230,300,255},false,false,summonHistoryWindow);env->addStaticText(L"去向",{330,230,625,255},false,false,summonHistoryWindow);
