 env->addButton({15,380,625,410},summonHistoryWindow,9915,L"加入素材及来源 → 去向");summonMaterialRows=env->addListBox({15,420,625,505},summonHistoryWindow,9916,true);summonMaterialRows->setItemHeight(25);env->addButton({15,515,160,545},summonHistoryWindow,9917,L"移除所选");summonMaterialStatus=env->addStaticText(L"",{170,515,625,548},false,true,summonHistoryWindow);env->addButton({15,560,625,590},summonHistoryWindow,9918,L"关闭");UpdateSummonHistoryUI();}
