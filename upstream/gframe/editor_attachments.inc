void RefreshAttachmentRows(){attachmentRows->clear();counterRows.clear();if(attachmentMaterial){for(const auto& m:draftMaterials){std::wstring row=std::wstring(dataManager.GetName(m.code))+L" ["+std::to_wstring(m.code)+L"] · 玩家 "+std::to_wstring(m.owner+1);attachmentRows->addItem(row.c_str());}}else for(const auto& c:draftCounters){counterRows.push_back(c.first);std::wstring row=std::wstring(dataManager.GetCounterName(c.first))+L" ["+std::to_wstring(c.first)+L"] × "+std::to_wstring(c.second);attachmentRows->addItem(row.c_str());}}
void FilterAttachments(){attachmentMatches.clear();attachmentResults->clear();std::wstring term=attachmentSearch->getText();if(attachmentMaterial){if(term.empty())return;for(const auto& row:dataManager.GetStringTable()){CardData data{};if(!dataManager.GetData(row.first,&data)||(data.type&TYPE_TOKEN))continue;if(dataManager.CardNameContains(row.second.name.c_str(),term.c_str())||std::to_wstring(row.first).find(term)!=std::wstring::npos)attachmentMatches.push_back(row.first);}}else for(const auto& row:dataManager._counterStrings){wchar_t hex[24]{};myswprintf(hex,L"0x%X",row.first);if(row.first&&row.first<=65535&&(term.empty()||dataManager.CardNameContains(row.second.c_str(),term.c_str())||std::to_wstring(row.first).find(term)!=std::wstring::npos||std::wstring(hex).find(term)!=std::wstring::npos))attachmentMatches.push_back(row.first);}std::sort(attachmentMatches.begin(),attachmentMatches.end());if(attachmentMatches.size()>200)attachmentMatches.resize(200);for(uint32_t id:attachmentMatches){std::wstring row=std::wstring(attachmentMaterial?dataManager.GetName(id):dataManager.GetCounterName(id))+L" ["+std::to_wstring(id)+L"]";attachmentResults->addItem(row.c_str());}}
void OpenAttachments(bool material){if(!attachmentReady){draftMaterials.clear();draftCounters.clear();for(const auto& m:currentMaterials)if(m.host_id==selectedID)draftMaterials.push_back({m.card_id,m.code,m.owner});for(const auto& c:currentCounters)if(c.card_id==selectedID)draftCounters[c.type]=c.count;attachmentReady=true;}attachmentMaterial=material;attachmentWindow->setText(material?L"添加超量素材":L"放置指示物");attachmentSearch->setText(L"");attachmentAmount->setText(L"1");attachmentOwner->setVisible(material);attachmentOwner->setSelected(ownerOther->isChecked()?1-player->getSelected():player->getSelected());attachmentWindow->getElementFromId(9888,true)->setVisible(!material);attachmentStatus->setText(L"返回后点击生成卡片／保存修改，配置才会生效。");FilterAttachments();RefreshAttachmentRows();formWindow->setVisible(false);mainGame->PopupElement(attachmentWindow);}
void AttachmentAction(int id){int result=attachmentResults->getSelected(),row=attachmentRows->getSelected();uint32_t count=0;if(id==9886||id==9888){if(!Number(attachmentAmount,count)||count>65535||(id==9886&&!count)){attachmentStatus->setText(L"请输入有效数量（添加至少 1，指示物最多 65535）");return;}}
 if(id==9886){if(result<0||size_t(result)>=attachmentMatches.size()){attachmentStatus->setText(L"请先从搜索结果选择卡片或指示物");return;}uint32_t code=attachmentMatches[result];if(attachmentMaterial){if(count+draftMaterials.size()>255){attachmentStatus->setText(L"超量素材合计最多 255 张");return;}for(uint32_t i=0;i<count;++i)draftMaterials.push_back({0,code,uint32_t(attachmentOwner->getSelected())});}else{if(draftCounters[code]+count>65535){attachmentStatus->setText(L"同类指示物最多 65535 个");return;}draftCounters[code]+=count;}}
 else if(row>=0){if(attachmentMaterial&&size_t(row)<draftMaterials.size())draftMaterials.erase(draftMaterials.begin()+row);else if(!attachmentMaterial&&size_t(row)<counterRows.size()){uint32_t type=counterRows[row];if(id==9888&&count)draftCounters[type]=count;else draftCounters.erase(type);}}
 RefreshAttachmentRows();}
bool QueueWithAttachments(const editor_command& cmd){if((cmd.opcode!=1&&cmd.opcode!=4)||(!attachmentReady&&!SummonHistoryNeeded()))return SingleMode::QueueEditorCommand(cmd);bool field=cmd.location==LOCATION_MZONE||cmd.location==LOCATION_SZONE||cmd.location==LOCATION_FZONE||cmd.location==LOCATION_PZONE;
 if(!draftMaterials.empty()&&(cmd.location!=LOCATION_MZONE||!(EffectiveType()&TYPE_XYZ))){status->setText(L"超量素材只能配置给场上的超量怪兽");return false;}if(!draftCounters.empty()&&(!field||!(cmd.position&POS_FACEUP))){status->setText(L"指示物只能放在场上表侧表示的卡片上");return false;}
 if(!attachmentReady){draftMaterials.clear();draftCounters.clear();for(const auto& m:currentMaterials)if(m.host_id==selectedID)draftMaterials.push_back({m.card_id,m.code,m.owner});for(const auto& c:currentCounters)if(c.card_id==selectedID)draftCounters[c.type]=c.count;}std::vector<editor_command> group{cmd};for(const auto& m:currentMaterials)if(m.host_id==selectedID&&std::none_of(draftMaterials.begin(),draftMaterials.end(),[&](const MaterialDraft& d){return d.id==m.card_id;})){editor_command c{};c.opcode=3;c.target_low=uint32_t(m.card_id);c.target_high=uint32_t(m.card_id>>32);c.player=cmd.player;group.push_back(c);}for(const auto& m:draftMaterials)if(!m.id){editor_command c{};c.opcode=9;c.target_low=cmd.target_low;c.target_high=cmd.target_high;c.code=m.code;c.owner=m.owner;c.player=cmd.player;c.value=1;group.push_back(c);}std::map<uint32_t,uint32_t> counters=draftCounters;for(const auto& c:currentCounters)if(c.card_id==selectedID&&!counters.count(c.type))counters[c.type]=0;for(const auto& row:counters){editor_command c{};c.opcode=10;c.target_low=cmd.target_low;c.target_high=cmd.target_high;c.code=row.first;c.value=row.second;c.player=cmd.player;group.push_back(c);}AppendSummonHistory(group,cmd);bool queued=SingleMode::QueueEditorGroup(group);if(queued)attachmentNewCode=cmd.opcode==1?cmd.code:0;return queued;}
void InitializeAttachments(){auto* env=mainGame->env;counterOpen=env->addButton({15,365,585,395},formContent,9870,L"放置指示物…");materialOpen=env->addButton({15,405,585,435},formContent,9871,L"添加超量素材…");attachmentWindow=env->addWindow({315,30,935,610},false,L"放置指示物",nullptr,9872);attachmentWindow->getCloseButton()->setID(9873);attachmentWindow->setVisible(false);env->addStaticText(L"搜索名称／编号",{15,40,135,65},false,false,attachmentWindow);attachmentSearch=env->addEditBox(L"",{135,35,605,68},true,attachmentWindow,9880);env->addStaticText(L"数量",{15,83,75,110},false,false,attachmentWindow);attachmentAmount=env->addEditBox(L"1",{75,78,195,110},true,attachmentWindow,9881);attachmentOwner=env->addComboBox({215,78,605,110},attachmentWindow,9882);attachmentOwner->addItem(L"素材持有者：玩家 1",0);attachmentOwner->addItem(L"素材持有者：玩家 2",1);attachmentResults=env->addListBox({15,125,605,275},attachmentWindow,9883,true);attachmentResults->setItemHeight(26);env->addButton({15,285,605,315},attachmentWindow,9886,L"添加所选（使用上方数量）");attachmentRows=env->addListBox({15,325,605,450},attachmentWindow,9884,true);attachmentRows->setItemHeight(26);env->addButton({15,460,300,490},attachmentWindow,9887,L"移除所选");env->addButton({315,460,605,490},attachmentWindow,9888,L"更新所选数量");attachmentStatus=env->addStaticText(L"",{15,500,605,527},false,true,attachmentWindow,9889);env->addButton({15,535,605,565},attachmentWindow,9874,L"返回卡片形态");}
